<Project Sdk="Godot.NET.Sdk/4.6.1">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <!-- Required for Godot 4 -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <!-- Disable NativeAOT, it breaks Windows exports. -->
    <PublishAOT>false</PublishAOT>
    <LangVersion>12.0</LangVersion>
    <!-- Enforce nullable warnings. -->
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Disable invalid/incompatible GodotSharp version warnings. -->
    <NoWarn>NU1605</NoWarn>
    <RootNamespace>com.forerunnergames.coa2</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <!-- Root the assemblies to avoid trimming. -->
    <TrimmerRootAssembly Include="GodotSharp" />
    <TrimmerRootAssembly Include="$(TargetName)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Required for GdUnit4. -->
    <PackageReference Include="gdUnit4.api" Version="5.0.0" />
    <!-- Required for GdUnit4 IDE support (Rider, Visual Studio, Visual Studio Code). -->
    <PackageReference Include="gdUnit4.test.adapter" Version="3.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="gdUnit4.analyzers" Version="1.0.0">
      <PrivateAssets>none</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NLog" Version="5.3.2" />
    <!-- Add Newtonsoft.Json for serialization. -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <None Include="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
</Project>
